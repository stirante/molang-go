# Generated by jsonte: one variable per state.
variable.#{state.name} = query.property('#{namespace}:#{state.name}')
    == #{state.value};
variable.#{state.name}_timer = (variable.#{state.name}_timer ?? 0)
    + query.delta_time * #{ speed * 2 };
#{condition} ? {
    variable.active = 1;
} : {
    variable.active = 0;
};
