temp.dir = query.is_on_ground && !query.is_in_water
    ? query.is_moving ? query.is_sprinting ? 2 : 1 : 0
    : query.is_in_water ? 3
    : 4;
for_each(temp.e, query.get_nearby_entities(8, 'minecraft:player'), {
    temp.d = temp.e->query.distance_from_camera;
    temp.nearest = math.min(temp.nearest ?? 99, temp.d); # keep the closest
});
temp.nearest < 3 ? {
    variable.alert = 1;
    return 1;
} : temp.nearest < 6 ? {
    variable.alert = 0.5;
} : {
    variable.alert = 0;
};
return 0;
