# core.autocrlf=true rewrites checked-out files to CRLF, but gofmt only ever emits LF -- so
# `gofmt -l` flags whole packages as unformatted and every "fix" produces a diff that is pure
# line-ending noise. Pinning the working-tree ending for the file types the toolchain rewrites
# removes the conflict rather than re-fighting it. The sibling featurelab-go repo carries the
# same list for the same reason.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# The golden fixtures are generated by cmd/gengolden and diffed byte-for-byte; a line-ending
# rewrite would show the whole file as changed and hide what actually moved.
testdata/*.json text eol=lf
*.json text eol=lf

*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
